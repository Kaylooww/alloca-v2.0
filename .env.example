# Copy this file to .env.local. Never commit .env.local.
# Supabase Project Settings > API. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Local development can use file:alloca.db; production must use a hosted database.
TURSO_DATABASE_URL=file:alloca.db
TURSO_AUTH_TOKEN=
